{
  "entities": {
    "Application": {
      "title": "School Application",
      "description": "Admissions application for new students",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "childFirstName": { "type": "string" },
        "childLastName": { "type": "string" },
        "childDateOfBirth": { "type": "string", "format": "date" },
        "childGender": { "type": "string", "enum": ["Male", "Female"] },
        "applyingForClass": { "type": "string" },
        "parentName": { "type": "string" },
        "parentEmail": { "type": "string", "format": "email" },
        "parentPhoneNumber": { "type": "string" },
        "residentialAddress": { "type": "string" },
        "birthCertificateUrl": { "type": "string" },
        "passportPhotoUrl": { "type": "string" },
        "status": { "type": "string", "enum": ["Pending", "Reviewed", "Accepted", "Rejected"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["childFirstName", "childLastName", "childDateOfBirth", "applyingForClass", "parentName", "parentEmail", "parentPhoneNumber", "status"]
    },
    "Inquiry": {
      "title": "General Inquiry",
      "description": "General contact form inquiries",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "phoneNumber": { "type": "string" },
        "subject": { "type": "string" },
        "message": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "email", "message", "createdAt"]
    },
    "BlogPost": {
      "title": "Blog Post",
      "description": "School news and articles",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "slug": { "type": "string" },
        "content": { "type": "string" },
        "excerpt": { "type": "string" },
        "author": { "type": "string" },
        "category": { "type": "string" },
        "thumbnailUrl": { "type": "string" },
        "published": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "slug", "content", "createdAt"]
    },
    "GalleryItem": {
      "title": "Gallery Item",
      "description": "Photos for the school gallery",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "imageUrl": { "type": "string" },
        "category": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["imageUrl", "createdAt"]
    }
  },
  "firestore": {
    "applications": {
      "schema": { "$ref": "entities/Application" },
      "description": "Stores student admission applications"
    },
    "inquiries": {
      "schema": { "$ref": "entities/Inquiry" },
      "description": "Stores contact form submissions"
    },
    "blogPosts": {
      "schema": { "$ref": "entities/BlogPost" },
      "description": "Stores school news and blog posts"
    },
    "gallery": {
      "schema": { "$ref": "entities/GalleryItem" },
      "description": "Stores gallery images"
    }
  }
}
