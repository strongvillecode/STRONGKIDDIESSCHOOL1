rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      // For this app, we'll allow specific emails or check an 'admins' collection
      return isSignedIn() && (
        request.auth.token.email in ['sodiq2b2@gmail.com'] || // User email from runtime
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Applications Collection ---
    match /applications/{appId} {
      function isValidApplication(data) {
        return data.keys().hasAll(['childFirstName', 'childLastName', 'childDateOfBirth', 'applyingForClass', 'parentName', 'parentEmail', 'parentPhoneNumber', 'status', 'createdAt', 'updatedAt'])
          && data.childFirstName is string && data.childFirstName.size() > 0 && data.childFirstName.size() <= 100
          && data.childLastName is string && data.childLastName.size() > 0 && data.childLastName.size() <= 100
          && data.parentEmail is string && data.parentEmail.matches('^[^@]+@[^@]+\\.[^@]+$')
          && data.status in ['Pending', 'Reviewed', 'Accepted', 'Rejected'];
      }

      // Public can create applications
      allow create: if isValidId(appId) 
        && isValidApplication(incoming())
        && incoming().status == 'Pending'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      // Only admins can read or update applications
      allow read, update, delete: if isAdmin();
    }

    // --- Inquiries Collection ---
    match /inquiries/{inquiryId} {
      function isValidInquiry(data) {
        return data.keys().hasAll(['name', 'email', 'message', 'createdAt'])
          && data.name is string && data.name.size() > 0
          && data.email is string && data.email.matches('^[^@]+@[^@]+\\.[^@]+$')
          && data.message is string && data.message.size() > 0 && data.message.size() <= 2000;
      }

      allow create: if isValidId(inquiryId) && isValidInquiry(incoming()) && incoming().createdAt == request.time;
      allow read, update, delete: if isAdmin();
    }

    // --- Blog Posts Collection ---
    match /blogPosts/{postId} {
      allow read: if true; // Public can read
      allow write: if isAdmin(); // Only admins can write
    }

    // --- Gallery Collection ---
    match /gallery/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // --- Admins Collection ---
    match /admins/{userId} {
      allow read: if isSignedIn();
      allow write: if false; // Managed via Firebase Console for maximum security
    }
  }
}
